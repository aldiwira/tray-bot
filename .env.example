# .env example — copy to .env and fill in. Only LLM_API_KEY is required.

# Any OpenAI-compatible host (OpenAI, OpenRouter, Ollama, vLLM, LiteLLM, ...).
# These two override config.yaml if set.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Bearer token for the host above
LLM_API_KEY=

# Example — OpenRouter:
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=anthropic/claude-sonnet-4
#   LLM_API_KEY=sk-or-...

# Example — local Ollama (no real key needed; set a dummy token):
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=llama3.1:8b
